# Suma de los primeros N números naturales

class SumaNaturales:

    def __init__(self, n):
        self.n = n

    def calcular_suma(self):
        suma = 0
        num = 1

        while num <= self.n:
            suma = suma + num
            num = num + 1

        return suma


# Programa principal
n = int(input("Ingrese la cantidad de números naturales: "))

suma_naturales = SumaNaturales(n)

print("LA SUMA ES:", suma_naturales.calcular_suma())
